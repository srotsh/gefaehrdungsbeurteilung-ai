{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm build",
  "regions": [
    "fra1"
  ],
  "functions": {
    "src/app/api/transcribe/route.ts": {
      "maxDuration": 300,
      "memory": 1024
    },
    "src/app/api/generate/route.ts": {
      "maxDuration": 300,
      "memory": 1024
    },
    "src/app/(dashboard)/**/pdf/route.tsx": {
      "maxDuration": 60,
      "memory": 1024
    }
  },
  "headers": [
    {
      "source": "/api/stripe/webhook",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cron/lead-drip",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/reminders",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/cron/user-drip",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/cleanup-audio",
      "schedule": "0 3 * * *"
    }
  ]
}
