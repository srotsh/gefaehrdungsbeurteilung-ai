{
  "name": "gefaehrdungsbeurteilung",
  "version": "0.1.0",
  "private": true,
  "description": "Gefaehrdungsbeurteilung nach Paragraph 5/6 ArbSchG - Voice-Rundgang zu audit-sicherem Dokument",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "core:sync": "pwsh ./scripts/sync-core.ps1",
    "gen": "pwsh -Command \"$env:PYTHONIOENCODING='utf-8'; cd ../../shared-core/scripts; python gen-all.py\"",
    "gen:tailwind": "pwsh -Command \"$env:PYTHONIOENCODING='utf-8'; cd ../../shared-core/scripts; python gen-all.py --only core\"",
    "gen:marketing": "pwsh -Command \"$env:PYTHONIOENCODING='utf-8'; cd ../../shared-core/scripts; python gen-all.py --only marketing\"",
    "gen:seo": "pwsh -Command \"$env:PYTHONIOENCODING='utf-8'; cd ../../shared-core/scripts; python gen-all.py --only seo\"",
    "gen:auth": "pwsh -Command \"$env:PYTHONIOENCODING='utf-8'; cd ../../shared-core/scripts; python gen-all.py --only auth\"",
    "gen:analytics": "pwsh -Command \"$env:PYTHONIOENCODING='utf-8'; cd ../../shared-core/scripts; python gen-all.py --only analytics\"",
    "gen:leads": "pwsh -Command \"$env:PYTHONIOENCODING='utf-8'; cd ../../shared-core/scripts; python gen-all.py --only leads\"",
    "db:reset": "supabase db reset --local",
    "db:types": "supabase gen types typescript --local > src/lib/supabase/database.types.ts",
    "smoketest": "pnpm type-check",
    "smoke:static": "pwsh -Command \"$env:PYTHONIOENCODING='utf-8'; cd ../../shared-core/scripts; python smoke-check.py\"",
    "preflight": "pnpm lint && pnpm type-check && pnpm build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@react-pdf/renderer": "^4.3.0",
    "@stripe/stripe-js": "^5.5.0",
    "@supabase/ssr": "^0.10.2",
    "@supabase/supabase-js": "^2.102.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.469.0",
    "next": "^14.2.35",
    "openai": "^4.80.1",
    "posthog-js": "^1.372.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "resend": "^4.1.2",
    "stripe": "^17.7.0",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.24.2",
    "@flow/core": "workspace:*",
    "@flow/auth": "workspace:*",
    "@flow/billing": "workspace:*",
    "@flow/ui": "workspace:*",
    "@flow/ai": "workspace:*",
    "@flow/pdf": "workspace:*",
    "@flow/storage": "workspace:*",
    "@flow/email": "workspace:*",
    "@flow/db": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.35",
    "postcss": "^8.5.10",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vitest": "^2.1.9"
  }
}
